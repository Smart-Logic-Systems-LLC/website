{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sls/social-links",
	"title": "Social Links",
	"category": "sls",
	"icon": "share",
	"description": "Footer social icons. Links left as # are treated as placeholders.",
	"attributes": {
		"x": {
			"type": "string",
			"default": "#"
		},
		"facebook": {
			"type": "string",
			"default": "#"
		},
		"instagram": {
			"type": "string",
			"default": "#"
		},
		"linkedin": {
			"type": "string",
			"default": "#"
		}
	},
	"supports": {
		"html": false,
		"className": false
	},
	"textdomain": "sls",
	"editorScript": "sls-blocks-editor",
	"render": "file:./render.php"
}
