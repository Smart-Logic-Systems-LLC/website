{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sls/brand",
	"title": "Brand Lockup",
	"category": "sls",
	"icon": "admin-site",
	"description": "Logo mark with the two-line wordmark.",
	"attributes": {
		"large": {
			"type": "boolean",
			"default": true
		},
		"link": {
			"type": "boolean",
			"default": true
		},
		"line1": {
			"type": "string",
			"default": "Smart Logic"
		},
		"line2": {
			"type": "string",
			"default": "Systems"
		}
	},
	"supports": {
		"html": false,
		"className": false
	},
	"textdomain": "sls",
	"editorScript": "sls-blocks-editor",
	"render": "file:./render.php"
}
