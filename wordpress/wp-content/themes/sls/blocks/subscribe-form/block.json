{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sls/subscribe-form",
	"title": "Subscribe Form",
	"category": "sls",
	"icon": "email-alt",
	"description": "Newsletter email signup. Set an endpoint once a newsletter provider is chosen.",
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": "you@company.com"
		},
		"buttonLabel": {
			"type": "string",
			"default": "Subscribe"
		},
		"endpoint": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"multiple": false
	},
	"textdomain": "sls",
	"editorScript": "sls-blocks-editor",
	"render": "file:./render.php"
}
